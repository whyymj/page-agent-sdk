# AI Agent 配置(复制本文件为 .env 并填入真实值;.env 已被 gitignore,不会入库)
VITE_AI_API_KEY=sk-your-api-key-here
VITE_AI_BASE_URL=https://api.deepseek.com
VITE_AI_MODEL=deepseek-v4-flash
# JSON / 结构化操作建议低温(0.2-0.3),提高格式与数值准确率
VITE_AI_TEMPERATURE=0.3
# 输出上限:不配则按模型自动取值(deepseek-v4→384K);如需限制可放开
# VITE_AI_MAX_TOKENS=16384
# 系统提示词(必须单行;.env 不支持多行值);page-demo 会用自有 systemPrompt 覆盖此项
VITE_AI_SYSTEM_PROMPT=你是通用 JSON 操作助手。通过工具读写集成方声明的主数据对象(仅限 schema 声明字段、经 schema 校验),并支持 GET 抓取文档。回答用中文,先结论后展开,不确定的明确说明。

# Anthropic 协议配置(rag-demo:provider:'anthropic' 走 modelverse 网关)
# dev 缺省经 vite 代理 location.origin/llm → api.modelverse.cn;直连时配 BASE_URL(注意 CORS/遥测头限制,见 demo 注释)
VITE_ANTHROPIC_API_KEY=sk-your-anthropic-key-here
VITE_ANTHROPIC_BASE_URL=https://api.modelverse.cn/
VITE_ANTHROPIC_MODEL=deepseek-v4-flash


# RAG MCP 服务地址(可选;mcp-demo 检测到即从 mock 模式切换为知识库检索模式)
# VITE_RAG_MCP_URL=

# 识图端点(images-demo 的 images.describe 调用;私有接口请勿入库,本地 .env 配置真实地址)
# 请求 POST {image: <base64>, mime: "image/png"} → {error_code:0, data:{description}}
# VITE_VISION_URL=
# 识图多模态模型(可选;配了此行走 anthropic messages 图像块协议,复用 VITE_ANTHROPIC_* 凭据组)
# VITE_VISION_MODEL=
# 识图端点基址(可选;相对路径 /llm 走 vite 同源代理防 CORS,绝对 URL 直连)
# VITE_VISION_BASE_URL=
